 "fields": [
  {
   "fieldname": "sec_intro",
   "fieldtype": "Section Break",
   "label": "Narxlar"
  },
  {
   "fieldname": "intro_izoh",
   "fieldtype": "HTML",
   "options": "<div class='text-muted' style='margin:-4px 0 8px'><b>Narxlar shu yerda.</b> Qatorning «Narx» ustunini o'zgartirib saqlang — yangi zakazlar darhol yangi narx bilan hisoblanadi (tasdiqlangan eskilari o'zgarmaydi). «Qalinlik gacha» pog'onali: 4 → ≤4 mm, 6 → 5–6 mm, 10 → 7–10 mm; yangi 8 mm oyna chiqsa 10 mm narxi o'zi topiladi, 12 mm uchun esa qator qo'shasiz (yoki 0 = zaxira qator). Izohda «TAXMINIY» — tasdiqlanmagan narx.</div>"
  },
  {
   "fieldname": "sec_n_oyna",
   "fieldtype": "Section Break",
   "label": "Oyna narxlari (so'm / m²)"
  },
  {
   "fieldname": "n_oyna_izoh",
   "fieldtype": "HTML",
   "options": "<div class='text-muted' style='margin:-4px 0 8px'>Har oyna turi (Item) uchun 1 m² narxi. Yangi oyna turi (8 mm bronza, ko'zgu, lakobel…) — avval Item'da «Oynalar» guruhida oching (qalinlik, rang, oyna turi bilan), keyin shu yerga qator qo'shing.</div>"
  },
  {
   "fieldname": "narx_oyna",
   "fieldtype": "Table",
   "label": "Oyna narxlari",
   "options": "Oyna Narx Oyna"
  },
  {
   "fieldname": "sec_n_qirra",
   "fieldtype": "Section Break",
   "label": "Qirra ishlovi narxlari (so'm / pog.m)"
  },
  {
   "fieldname": "n_qirra_izoh",
   "fieldtype": "HTML",
   "options": "<div class='text-muted' style='margin:-4px 0 8px'>Tomon uzunligi (m) × narx. Faska uchun «Kenglik gacha»: 10 → 0–10 mm, 20 → 10–20 mm.</div>"
  },
  {
   "fieldname": "narx_qirra",
